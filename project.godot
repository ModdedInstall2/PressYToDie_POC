; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DeadmanDEMO"
config/version="0.0.1d"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

TurretSignal="*res://TurretSignal.gd"

[display]

window/size/viewport_width=473
window/size/viewport_height=264
window/size/mode=3
window/size/resizable=false
window/size/extend_to_title=true
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[editor]

movie_writer/movie_file="E:/ModdedInstall2/Documents/PressYToDie_POC/movie.avi"
movie_writer/disable_vsync=true
version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/magic_button/plugin.cfg", "res://addons/vision_cone_2d/plugin.cfg")

[global_group]

"Cube And Button Based Testing"=""
"Lethal Military Android Targeting"=""
"Lethal Military Androids"=""
"Testing Facility"=""
"Test Subject 234"=""

